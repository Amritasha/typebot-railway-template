# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (use Railway's Postgres plugin)
DATABASE_URL=postgresql://user:password@host:5432/typebot

# Full public URL of the builder service (e.g. https://typebot-builder.up.railway.app)
NEXTAUTH_URL=https://your-builder.up.railway.app

# Full public URL of the viewer service (e.g. https://typebot-viewer.up.railway.app)
NEXT_PUBLIC_VIEWER_URL=https://your-viewer.up.railway.app

# Random 32-character secret — generate with: openssl rand -hex 16
ENCRYPTION_SECRET=

# Random secret for NextAuth — generate with: openssl rand -hex 32
NEXTAUTH_SECRET=

# ── Access control ─────────────────────────────────────────────────────────────

# Pre-authorize this email as admin on first launch
ADMIN_EMAIL=

# Set to "true" to prevent new users from signing up
DISABLE_SIGNUP=false

# ── Email (SMTP) ───────────────────────────────────────────────────────────────

SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
NEXT_PUBLIC_SMTP_FROM=notifications@your-domain.com

# ── File storage (S3-compatible) ───────────────────────────────────────────────

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=typebot-storage
S3_REGION=us-east-1
S3_ENDPOINT=

# ── OAuth providers (optional) ────────────────────────────────────────────────

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_BASE_URL=https://gitlab.com

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

MICROSOFT_ENTRA_TENANT_ID=
MICROSOFT_ENTRA_CLIENT_ID=
MICROSOFT_ENTRA_CLIENT_SECRET=

CUSTOM_OAUTH_CLIENT_ID=
CUSTOM_OAUTH_CLIENT_SECRET=
CUSTOM_OAUTH_WELL_KNOWN_URL=
CUSTOM_OAUTH_DISPLAY_NAME=
CUSTOM_OAUTH_REQUIRED_GROUPS=
CUSTOM_OAUTH_USER_ID_PATH=
CUSTOM_OAUTH_USER_NAME_PATH=
CUSTOM_OAUTH_USER_EMAIL_PATH=
CUSTOM_OAUTH_USER_IMAGE_PATH=
